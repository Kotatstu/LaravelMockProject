{
    "name": "Updated USB Cable",
    "sku": "USB-001"
}

###Delete by id
DELETE  {{baseUrl}}/product/delete/

//============================================== STOCK CONTROLLER ===============================================================
###Get all stock
GET {{baseUrl}}/stock

