//======================================================= PurchaseOrderController =================================
###Get all
GET {{baseUrl}}/purchaseOrder

###Create new
POST {{baseUrl}}/purchaseOrder/create
Content-Type: application/json

{
      "reference": "Cyberpunk",
      "supplier_id": 1,
      "status": "Pending",
      "items": [{
        "product_id": 2,
        "quantity": 2077
      }]
}

###Get by id
GET {{baseUrl}}/purchaseOrder/2

###Update by id
PUT {{baseUrl}}/purchaseOrder/update/2
Content-Type: application/json

{
    "status": "Ongoing"
}

###Delete by id
DELETE {{baseUrl}}/purchaseOrder/delete/1

###Received an order, called service layer
POST {{baseUrl}}/purchaseOrder/3/receive
Content-Type: application/json

{
    "warehouse_id": 2
}