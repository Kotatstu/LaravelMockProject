//======================================================= PurchaseOrderController =================================
###Get all
GET {{baseUrl}}/purchaseOrder
Accept: application/json
Authorization: {{token}}

###Create new
POST {{baseUrl}}/purchaseOrder/create
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
      "reference": "Token Test",
      "supplier_id": 1,
      "status": "Pending",
      "items":
      [
        {
            "product_id": 1,
            "quantity": 100
        },
        {
            "product_id": 3,
            "quantity": 100
        }
      ]
}

###Get by id
GET {{baseUrl}}/purchaseOrder/2
Accept: application/json
Authorization: {{token}}

###Update by id
PUT {{baseUrl}}/purchaseOrder/update/2
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
    "status": "Pending"
}

###Delete by id
DELETE {{baseUrl}}/purchaseOrder/delete/3
Accept: application/json
Authorization: {{token}}

###Received an order, called service layer
POST {{baseUrl}}/purchaseOrder/11/receive
Content-Type: application/json
Accept: application/json
Authorization: {{token}}

{
    "warehouse_id": 2,
    "items":
    [
        {
            "purchase_order_item_id": 11,
            "quantity": 100
        },

        {
            "purchase_order_item_id": 12,
            "quantity": 100
        }

    ]
}

//============================================== STOCK EXPORT CONTROLLER =========================================
